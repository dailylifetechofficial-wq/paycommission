  <!-- ==================== CLIENT SCRIPT: GRATUITY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Gratuity Calculator Engine
    const gratuityPayLevel = document.getElementById('gratuityPayLevel');
    const lastBasicPay = document.getElementById('lastBasicPay');
    const gratuityFitment = document.getElementById('gratuityFitment');
    const qualifyingYears = document.getElementById('qualifyingYears');
    const proposedCeilingOption = document.getElementById('proposedCeilingOption');

    const valEmoluments = document.getElementById('valEmoluments');
    const valSmpCount = document.getElementById('valSmpCount');
    const valFormulaMultiplier = document.getElementById('valFormulaMultiplier');
    const valGrossCalculated = document.getElementById('valGrossCalculated');
    const valAppliedCeiling = document.getElementById('valAppliedCeiling');
    const valPayableGratuity = document.getElementById('valPayableGratuity');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateGratuity() {
      const basic = parseFloat(lastBasicPay.value) || 0;
      const fitment = parseFloat(gratuityFitment.value) || 2.28;
      const years = Math.min(33, Math.max(5, parseFloat(qualifyingYears.value) || 33));
      const statutoryCeiling = parseFloat(proposedCeilingOption.value) || 3500000;

      // 1. Revised Emoluments (Basic * Fitment, DA is 0% at inception or included in base)
      const emoluments = basic * fitment;

      // 2. Completed Six-Monthly Periods (SMP) - 2 per completed year, capped at 66
      const smp = Math.min(66, years * 2);

      // 3. Formula Multiplier: (1/4 * SMP), max capped at 16.5
      const multiplier = Math.min(16.5, (smp / 4));

      // 4. Gross Calculated Gratuity
      const grossCalculated = emoluments * multiplier;

      // 5. Final Payable: lesser of gross calculated and statutory ceiling
      const payableGratuity = Math.min(grossCalculated, statutoryCeiling);

      // Update UI elements
      valEmoluments.innerText = formatINR(emoluments);
      valSmpCount.innerText = `${smp} Periods (${years} Years)`;
      valFormulaMultiplier.innerText = `${multiplier.toFixed(2)}x ${multiplier === 16.5 ? '(Max Cap)' : ''}`;
      valGrossCalculated.innerText = formatINR(grossCalculated);
      valAppliedCeiling.innerText = formatINR(statutoryCeiling);
      valPayableGratuity.innerText = formatINR(payableGratuity);
    }

    // Sync basic pay when pay level selection changes
    gratuityPayLevel.addEventListener('change', (e) => {
      lastBasicPay.value = e.target.value;
      calculateGratuity();
    });

    lastBasicPay.addEventListener('input', calculateGratuity);
    gratuityFitment.addEventListener('change', calculateGratuity);
    qualifyingYears.addEventListener('input', calculateGratuity);
    proposedCeilingOption.addEventListener('change', calculateGratuity);

    // Initial calculation run
    calculateGratuity();
  </script>
</body>
