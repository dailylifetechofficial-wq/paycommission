    function calculatePension() {
      const currentBasic = parseFloat(pensionInput.value) || 0;
      const fitment = parseFloat(fitmentSelect.value) || 2.28;
      const commuteRate = (parseFloat(commuteSelect.value) || 0) / 100;
      const ageRate = parseFloat(ageSelect.value) || 0;

      // Revised Basic Pension
      const revisedBasic = currentBasic * fitment;

      // Age Topup
      const ageTopup = revisedBasic * ageRate;

      // Commuted deduction
      const commutedDeduction = revisedBasic * commuteRate;

      // Fixed Medical Allowance estimation
      const estimatedFma = 2000;

      // Net Monthly Take-Home (Revised + Age Topup - Commutation + FMA)
      const netPension = (revisedBasic + ageTopup - commutedDeduction) + estimatedFma;

      dispRevisedBasic.innerText = formatINR(revisedBasic);
      dispAgeTopup.innerText = formatINR(ageTopup);
      dispCommutation.innerText = commutedDeduction > 0 ? ('- ' + formatINR(commutedDeduction)) : '₹0';
      dispFma.innerText = formatINR(estimatedFma);
      dispNetMonthly.innerText = formatINR(netPension);
    }

    pensionInput.addEventListener('input', calculatePension);
    fitmentSelect.addEventListener('change', calculatePension);
    commuteSelect.addEventListener('change', calculatePension);
    ageSelect.addEventListener('change', calculatePension);

    // Initial run
    calculatePension();
  </script>
</body>
</html>

