---
// src/pages/terms-of-condition.astro
const title = "Terms of Condition - 8PayCommission.com (2026)";
const description = "Terms of Condition for 8PayCommission.com. Review our computational disclaimers, intellectual property terms, educational scope, and liability limits.";
const canonicalUrl = "https://8paycommission.com/terms-of-condition/";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />

  <!-- Structured Data: WebPage & Organization Schema for Legal Transparency -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "8PayCommission",
          "url": "https://8paycommission.com",
          "logo": "https://8paycommission.com/favicon.svg",
          "email": "dailylifetech.official@gmail.com"
        },
        {
          "@type": "WebPage",
          "name": "Terms of Condition - 8PayCommission",
          "url": "https://8paycommission.com/terms-of-condition/",
          "description": "Terms of condition, legal disclaimer, usage conditions, and limitation of liability for 8PayCommission.com."
