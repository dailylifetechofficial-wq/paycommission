  <!-- ==================== CLIENT SCRIPT: MAHARASHTRA SALARY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Maharashtra Salary Calculation Engine
    const mhLevelSelect = document.getElementById('mhLevelSelect');
    const mhCurrentBasic = document.getElementById('mhCurrentBasic');
    const mhFitmentSelect = document.getElementById('mhFitmentSelect');
    const mhCityCategorySelect = document.getElementById('mhCityCategorySelect');
    const mhPensionScheme = document.getElementById('mhPensionScheme');

    const outMhRevisedBasic = document.getElementById('outMhRevisedBasic');
    const outMhHra = document.getElementById('outMhHra');
    const outMhTa = document.getElementById('outMhTa');
    const outMhGross = document.getElementById('outMhGross');
    const outMhPensionDeduct = document.getElementById('outMhPensionDeduct');
    const outMhFixedDeduct = document.getElementById('outMhFixedDeduct');
    const outMhNetTakeHome = document.getElementById('outMhNetTakeHome');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateMhSalary() {
      const basic = parseFloat(mhCurrentBasic.value) || 0;
      const fitment = parseFloat(mhFitmentSelect.value) || 2.28;
      const hraRate = parseFloat(mhCityCategorySelect.value) || 0.27;
      const pensionRate = parseFloat(mhPensionScheme.value) || 0.10;

      // 1. Revised Basic Pay (rounded to nearest 100)
      const revisedBasic = Math.round((basic * fitment) / 100) * 100;

      // 2. House Rent Allowance (HRA) with Maharashtra floor protection
      let calculatedHra = revisedBasic * hraRate;
      let floorLimit = 3690;
      if (hraRate >= 0.27) floorLimit = 11080;
      else if (hraRate >= 0.18) floorLimit = 7390;
      calculatedHra = Math.max(calculatedHra, floorLimit);

      // 3. Transport Allowance (TA estimation)
      const selectedOption = mhLevelSelect.options[mhLevelSelect.selectedIndex];
      const levelStr = selectedOption.getAttribute('data-level') || 'S-6';
      const levelNum = parseInt(levelStr.replace('S-', '')) || 6;
      let baseTa = (levelNum >= 15) ? 7200 : (levelNum >= 6 ? 3600 : 1350);
      if (hraRate < 0.18) {
        baseTa = (levelNum >= 15) ? 3600 : (levelNum >= 6 ? 1800 : 900);
      }
      const calculatedTa = baseTa * 1.60;

      // 4. Estimated Gross Salary
      const grossSalary = revisedBasic + calculatedHra + calculatedTa;

      // 5. Deductions
      const pensionDeduction = revisedBasic * pensionRate;
      const fixedDeductions = 400; // GIS (Group Insurance Scheme) + Maharashtra Professional Tax (~₹200)
      const totalDeductions = pensionDeduction + fixedDeductions;

      // 6. Net Take-Home Pay
      const netSalary = grossSalary - totalDeductions;

      // Update DOM
      outMhRevisedBasic.innerText = formatINR(revisedBasic);
      outMhHra.innerText = formatINR(calculatedHra);
      outMhTa.innerText = formatINR(calculatedTa);
      outMhGross.innerText = formatINR(grossSalary);
      outMhPensionDeduct.innerText = pensionDeduction > 0 ? ('- ' + formatINR(pensionDeduction)) : '₹0 (GPF)';
      outMhFixedDeduct.innerText = '- ' + formatINR(fixedDeductions);
      outMhNetTakeHome.innerText = formatINR(netSalary);
    }

    // Sync input when MH Level dropdown changes
    mhLevelSelect.addEventListener('change', (e) => {
      mhCurrentBasic.value = e.target.value;
      calculateMhSalary();
    });

    mhCurrentBasic.addEventListener('input', calculateMhSalary);
    mhFitmentSelect.addEventListener('change', calculateMhSalary);
    mhCityCategorySelect.addEventListener('change', calculateMhSalary);
    mhPensionScheme.addEventListener('change', calculateMhSalary);

    // Initial run
    calculateMhSalary();
  </script>
</body>
