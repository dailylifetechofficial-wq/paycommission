  <!-- ==================== CLIENT SCRIPT: LEVEL 10-18 SIMULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Level 10 to 18 Inspection Engine
    const selectApexLevel = document.getElementById('selectApexLevel');
    const fitmentFactorApex = document.getElementById('fitmentFactorApex');
    const cellStepApex = document.getElementById('cellStepApex');
    const cityTierApex = document.getElementById('cityTierApex');

    const dispCellBasic = document.getElementById('dispCellBasic');
    const dispOldReference = document.getElementById('dispOldReference');
    const dispHraValue = document.getElementById('dispHraValue');
    const dispTaValue = document.getElementById('dispTaValue');
    const dispGrossTotal = document.getElementById('dispGrossTotal');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateApexCompensation() {
      const selectedOption = selectApexLevel.options[selectApexLevel.selectedIndex];
      const base7th = parseFloat(selectedOption.getAttribute('data-7th')) || 56100;
      const gp = selectedOption.getAttribute('data-gp') || '5400';
      const lvl = parseInt(selectApexLevel.value) || 10;
      const fitment = parseFloat(fitmentFactorApex.value) || 2.28;
      const cellStep = parseInt(cellStepApex.value) || 1;
      const hraRate = parseFloat(cityTierApex.value) || 0.27;

      // 1. Calculate Cell 1 Starting Base (rounded to nearest 100)
      const cellOne = Math.round((base7th * fitment) / 100) * 100;

      // 2. Compound vertically at 3% per annual increment step (unless fixed levels 17 or 18)
      let currentCellPay = cellOne;
      if (lvl < 17) {
        for (let i = 1; i < cellStep; i++) {
          currentCellPay = Math.round((currentCellPay * 1.03) / 100) * 100;
        }
      }

      // 3. Calculate HRA
      let calculatedHra = currentCellPay * hraRate;
      if (lvl === 18 && hraRate >= 0.27) {
        // Cabinet Secretary receives official residence (noted as standard allowance or bungalow)
        calculatedHra = currentCellPay * hraRate;
      }

      // 4. Calculate Transport Allowance
      // Level 10 to 13 = Band 1 TA (₹7,200 base); Level 14+ = ₹15,750 base or staff car
      let baseTa = 7200;
      if (lvl >= 14) {
        baseTa = 15750;
      }
      if (hraRate < 0.18 && lvl < 14) {
        baseTa = 3600;
      }
      const calculatedTa = baseTa * 1.60; // 8th CPC baseline expansion

      // 5. Calculate Gross Monthly Total
      const grossTotal = currentCellPay + calculatedHra + calculatedTa;

      // Update UI
      dispCellBasic.innerText = formatINR(currentCellPay);
      dispOldReference.innerText = `${formatINR(base7th)} (${gp === 'HAG' || gp === 'HAG+' || gp === 'Apex' || gp === 'Cabinet' ? gp : 'GP ₹' + gp})`;
      dispHraValue.innerText = formatINR(calculatedHra);
      dispTaValue.innerText = (lvl >= 14) ? `${formatINR(calculatedTa)} / Staff Car` : formatINR(calculatedTa);
      dispGrossTotal.innerText = formatINR(grossTotal);
    }

    selectApexLevel.addEventListener('change', calculateApexCompensation);
    fitmentFactorApex.addEventListener('change', calculateApexCompensation);
    cellStepApex.addEventListener('change', calculateApexCompensation);
    cityTierApex.addEventListener('change', calculateApexCompensation);

    // Initial run
    calculateApexCompensation();
  </script>
