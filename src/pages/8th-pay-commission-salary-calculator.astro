  <!-- ==================== CLIENT SCRIPT: SALARY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation toggle for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Salary Calculator Engine
    const payLevelSelect = document.getElementById('payLevelSelect');
    const basicPayField = document.getElementById('basicPayField');
    const fitmentFactorSelect = document.getElementById('fitmentFactorSelect');
    const cityTierSelect = document.getElementById('cityTierSelect');
    const pensionSchemeSelect = document.getElementById('pensionSchemeSelect');

    const outBasicPay = document.getElementById('outBasicPay');
    const outHra = document.getElementById('outHra');
    const outTa = document.getElementById('outTa');
    const outGross = document.getElementById('outGross');
    const outPensionDeduct = document.getElementById('outPensionDeduct');
    const outFixedDeduct = document.getElementById('outFixedDeduct');
    const outNetTakeHome = document.getElementById('outNetTakeHome');

    function formatCurrency(num) {
      return '₹' + Math.round(num).toLocaleString('en-IN');
    }

    function calculateSalary() {
      const basic = parseFloat(basicPayField.value) || 0;
      const fitment = parseFloat(fitmentFactorSelect.value) || 2.28;
      const hraRate = parseFloat(cityTierSelect.value) || 0.27;
      const pensionRate = parseFloat(pensionSchemeSelect.value) || 0.10;

      // 1. Revised Basic Pay
      const newBasic = basic * fitment;

      // 2. House Rent Allowance (HRA)
      const newHra = newBasic * hraRate;

      // 3. Transport Allowance (Tier-scaled estimation)
      const baseTa = basic >= 35400 ? 3600 : 1350;
      const newTa = baseTa * 1.6;

      // 4. Gross Earnings
      const gross = newBasic + newHra + newTa;

      // 5. Deductions
      const pensionDeduction = newBasic * pensionRate;
      const fixedDeductions = 650; // CGEGIS (approx ₹120-₹200) + State Professional Tax (approx ₹200) + Health Scheme
      const totalDeductions = pensionDeduction + fixedDeductions;

      // 6. Net Take-Home
      const netSalary = gross - totalDeductions;

      // Update DOM
      outBasicPay.innerText = formatCurrency(newBasic);
      outHra.innerText = formatCurrency(newHra);
      outTa.innerText = formatCurrency(newTa);
      outGross.innerText = formatCurrency(gross);
      outPensionDeduct.innerText = pensionDeduction > 0 ? ('- ' + formatCurrency(pensionDeduction)) : '₹0 (GPF)';
      outFixedDeduct.innerText = '- ' + formatCurrency(fixedDeductions);
      outNetTakeHome.innerText = formatCurrency(netSalary);
    }

    // Sync basic pay when level changes
    payLevelSelect.addEventListener('change', (e) => {
      basicPayField.value = e.target.value;
      calculateSalary();
    });

    basicPayField.addEventListener('input', calculateSalary);
    fitmentFactorSelect.addEventListener('change', calculateSalary);
    cityTierSelect.addEventListener('change', calculateSalary);
    pensionSchemeSelect.addEventListener('change', calculateSalary);

    // Initial calculation on page render
    calculateSalary();
  </script>
