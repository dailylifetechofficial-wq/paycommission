  <!-- ==================== CLIENT SCRIPT: MATRIX INSPECTOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Pay Matrix Inspection Engine
    const selectPayLevel = document.getElementById('selectPayLevel');
    const matrixFitmentSelect = document.getElementById('matrixFitmentSelect');
    const completedYearsIndex = document.getElementById('completedYearsIndex');

    const dispCellOnePay = document.getElementById('dispCellOnePay');
    const disp7thReference = document.getElementById('disp7thReference');
    const dispComputedCellPay = document.getElementById('dispComputedCellPay');
    const dispNextIncrementYield = document.getElementById('dispNextIncrementYield');
    const dispFinalCellBasic = document.getElementById('dispFinalCellBasic');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateMatrixCell() {
      const selectedOption = selectPayLevel.options[selectPayLevel.selectedIndex];
      const base7th = parseFloat(selectedOption.getAttribute('data-7th')) || 35400;
      const gpLabel = selectedOption.getAttribute('data-gp') || '4200';
      const fitment = parseFloat(matrixFitmentSelect.value) || 2.28;
      const cellIndex = parseInt(completedYearsIndex.value) || 1;

      // 1. Compute Cell 1 Base Pay under 8th CPC (rounded to nearest 100)
      const cellOne = Math.round((base7th * fitment) / 100) * 100;

      // 2. Compound vertically at 3% per completed increment
      let currentCellPay = cellOne;
      for (let i = 1; i < cellIndex; i++) {
        currentCellPay = Math.round((currentCellPay * 1.03) / 100) * 100;
      }

      // 3. Compute next vertical increment yield
      const nextYield = Math.round((currentCellPay * 0.03) / 100) * 100;

      // Update DOM
      dispCellOnePay.innerText = formatINR(cellOne);
      disp7thReference.innerText = `${formatINR(base7th)} (GP ₹${gpLabel})`;
      dispComputedCellPay.innerText = formatINR(currentCellPay);
      dispNextIncrementYield.innerText = '+ ' + formatINR(nextYield) + ' / yr';
      dispFinalCellBasic.innerText = formatINR(currentCellPay);
    }

    selectPayLevel.addEventListener('change', calculateMatrixCell);
    matrixFitmentSelect.addEventListener('change', calculateMatrixCell);
    completedYearsIndex.addEventListener('change', calculateMatrixCell);

    // Initial run
    calculateMatrixCell();
  </script>
