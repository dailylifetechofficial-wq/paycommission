  <!-- ==================== CLIENT SCRIPT: WB SALARY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time West Bengal Salary Calculation Engine
    const wbLevelSelect = document.getElementById('wbLevelSelect');
    const wbCurrentBasic = document.getElementById('wbCurrentBasic');
    const wbFitmentSelect = document.getElementById('wbFitmentSelect');
    const wbDaScenarioSelect = document.getElementById('wbDaScenarioSelect');
    const wbHraOptionSelect = document.getElementById('wbHraOptionSelect');

    const outWbRevisedBasic = document.getElementById('outWbRevisedBasic');
    const outWbHra = document.getElementById('outWbHra');
    const outWbMa = document.getElementById('outWbMa');
    const outWbDa = document.getElementById('outWbDa');
    const outWbGross = document.getElementById('outWbGross');
    const outWbGpfDeduct = document.getElementById('outWbGpfDeduct');
    const outWbPtDeduct = document.getElementById('outWbPtDeduct');
    const outWbNetTakeHome = document.getElementById('outWbNetTakeHome');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateWbSalary() {
      const basic = parseFloat(wbCurrentBasic.value) || 0;
      const fitment = parseFloat(wbFitmentSelect.value) || 2.28;
      const daRate = parseFloat(wbDaScenarioSelect.value) || 0.00;
      const hraRate = parseFloat(wbHraOptionSelect.value) || 0.12;

      // 1. Revised Basic Pay (rounded to nearest 100)
      const revisedBasic = Math.round((basic * fitment) / 100) * 100;

      // 2. House Rent Allowance (12% capped at ₹12,000 under WB ROPA rules)
      let calculatedHra = 0;
      if (hraRate > 0) {
        calculatedHra = Math.min(12000, revisedBasic * hraRate);
      }

      // 3. Medical Allowance (Fixed ₹500 in WB)
      const maAmount = 500;

      // 4. Dearness Allowance (DA)
      const daAmount = revisedBasic * daRate;

      // 5. Estimated Gross Salary
      const grossSalary = revisedBasic + calculatedHra + maAmount + daAmount;

      // 6. Deductions: GPF minimum 6% of basic + Professional Tax (PT ₹200)
      const gpfDeduct = Math.round(revisedBasic * 0.06);
      const ptDeduct = 200;
      const totalDeductions = gpfDeduct + ptDeduct;

      // 7. Net Take-Home Pay
      const netSalary = grossSalary - totalDeductions;

      // Update DOM
      outWbRevisedBasic.innerText = formatINR(revisedBasic);
      outWbHra.innerText = formatINR(calculatedHra);
      outWbMa.innerText = formatINR(maAmount);
      outWbDa.innerText = daRate > 0 ? (formatINR(daAmount) + ` (${(daRate * 100).toFixed(0)}%)`) : '₹0 (0% Merged)';
      outWbGross.innerText = formatINR(grossSalary);
      outWbGpfDeduct.innerText = '- ' + formatINR(gpfDeduct);
      outWbPtDeduct.innerText = '- ' + formatINR(ptDeduct);
      outWbNetTakeHome.innerText = formatINR(netSalary);
    }

    // Sync input when WB Level dropdown changes
    wbLevelSelect.addEventListener('change', (e) => {
      wbCurrentBasic.value = e.target.value;
      calculateWbSalary();
    });

    wbCurrentBasic.addEventListener('input', calculateWbSalary);
    wbFitmentSelect.addEventListener('change', calculateWbSalary);
    wbDaScenarioSelect.addEventListener('change', calculateWbSalary);
    wbHraOptionSelect.addEventListener('change', calculateWbSalary);

    // Initial run
    calculateWbSalary();
  </script>
