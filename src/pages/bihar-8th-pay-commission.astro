  <!-- ==================== CLIENT SCRIPT: BIHAR SALARY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Bihar Salary Calculation Engine
    const biharCadreSelect = document.getElementById('biharCadreSelect');
    const biharCurrentBasic = document.getElementById('biharCurrentBasic');
    const biharFitmentSelect = document.getElementById('biharFitmentSelect');
    const biharCityTierSelect = document.getElementById('biharCityTierSelect');
    const biharPensionScheme = document.getElementById('biharPensionScheme');

    const outBiharRevisedBasic = document.getElementById('outBiharRevisedBasic');
    const outBiharHra = document.getElementById('outBiharHra');
    const outBiharMa = document.getElementById('outBiharMa');
    const outBiharTa = document.getElementById('outBiharTa');
    const outBiharGross = document.getElementById('outBiharGross');
    const outBiharPensionDeduct = document.getElementById('outBiharPensionDeduct');
    const outBiharFixedDeduct = document.getElementById('outBiharFixedDeduct');
    const outBiharNetTakeHome = document.getElementById('outBiharNetTakeHome');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateBiharSalary() {
      const basic = parseFloat(biharCurrentBasic.value) || 0;
      const fitment = parseFloat(biharFitmentSelect.value) || 2.28;
      const hraRate = parseFloat(biharCityTierSelect.value) || 0.16;
      const pensionRate = parseFloat(biharPensionScheme.value) || 0.10;

      // 1. Revised Basic Pay (rounded to nearest 100)
      const revisedBasic = Math.round((basic * fitment) / 100) * 100;

      // 2. House Rent Allowance (HRA) with Bihar floor protection
      let calculatedHra = revisedBasic * hraRate;
      let floorLimit = 3690;
      if (hraRate >= 0.16) floorLimit = 7390;
      else if (hraRate >= 0.08) floorLimit = 4200;
      calculatedHra = Math.max(calculatedHra, floorLimit);

      // 3. Fixed Medical Allowance in Bihar
      const maAmount = 1000;

      // 4. Transport Allowance (TA estimation)
      const selectedOption = biharCadreSelect.options[biharCadreSelect.selectedIndex];
      const levelAttr = selectedOption.getAttribute('data-level') || '6';
      let baseTa = 1800;
      if (levelAttr === '9' || levelAttr === '11') baseTa = 3600;
      else if (levelAttr === '1' || levelAttr === '2') baseTa = 900;
      if (hraRate >= 0.16) baseTa = baseTa * 1.5; // Patna Urban higher TA
      const calculatedTa = baseTa * 1.60;

      // 5. Estimated Gross Salary
      const grossSalary = revisedBasic + calculatedHra + maAmount + calculatedTa;

      // 6. Deductions
      const pensionDeduction = revisedBasic * pensionRate;
      const fixedDeductions = 350; // GIS (Group Insurance) + Professional Tax
      const totalDeductions = pensionDeduction + fixedDeductions;

      // 7. Net Take-Home Pay
      const netSalary = grossSalary - totalDeductions;

      // Update DOM
      outBiharRevisedBasic.innerText = formatINR(revisedBasic);
      outBiharHra.innerText = formatINR(calculatedHra);
      outBiharMa.innerText = formatINR(maAmount);
      outBiharTa.innerText = formatINR(calculatedTa);
      outBiharGross.innerText = formatINR(grossSalary);
      outBiharPensionDeduct.innerText = pensionDeduction > 0 ? ('- ' + formatINR(pensionDeduction)) : '₹0 (GPF)';
      outBiharFixedDeduct.innerText = '- ' + formatINR(fixedDeductions);
      outBiharNetTakeHome.innerText = formatINR(netSalary);
    }

    // Sync input when Bihar Cadre dropdown changes
    biharCadreSelect.addEventListener('change', (e) => {
      biharCurrentBasic.value = e.target.value;
      calculateBiharSalary();
    });

    biharCurrentBasic.addEventListener('input', calculateBiharSalary);
    biharFitmentSelect.addEventListener('change', calculateBiharSalary);
    biharCityTierSelect.addEventListener('change', calculateBiharSalary);
    biharPensionScheme.addEventListener('change', calculateBiharSalary);

    // Initial run
    calculateBiharSalary();
  </script>
