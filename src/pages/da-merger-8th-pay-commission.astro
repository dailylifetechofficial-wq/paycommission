  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time DA Merger Simulation Engine
    const currentBasicInput = document.getElementById('currentBasic');
    const currentDaRateSelect = document.getElementById('currentDaRate');
    const fitmentOptionSelect = document.getElementById('fitmentOption');
    const futureHikeRateSelect = document.getElementById('futureHikeRate');

    const dispOldDaAmount = document.getElementById('dispOldDaAmount');
    const dispNewBasic = document.getElementById('dispNewBasic');
    const dispOldHikeYield = document.getElementById('dispOldHikeYield');
    const dispNewHikeYield = document.getElementById('dispNewHikeYield');
    const dispNetMonthlyAdvantage = document.getElementById('dispNetMonthlyAdvantage');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateDaDynamics() {
      const basic = parseFloat(currentBasicInput.value) || 0;
      const daRate = parseFloat(currentDaRateSelect.value) || 0.53;
      const fitment = parseFloat(fitmentOptionSelect.value) || 2.28;
      const futureHike = parseFloat(futureHikeRateSelect.value) || 0.03;

      // 1. Current DA Amount Drawn
      const oldDaAmount = basic * daRate;

      // 2. Revised 8th CPC Basic Pay (absorbing the old DA)
      const newBasic = basic * fitment;

      // 3. Old Yield of a future hike on 7th CPC basic
      const oldHikeYield = basic * futureHike;

      // 4. New Yield of that same hike on the 8th CPC basic
      const newHikeYield = newBasic * futureHike;

      // 5. Net Monthly Compounding Advantage
      const netAdvantage = newHikeYield - oldHikeYield;

      // Update DOM
      dispOldDaAmount.innerText = formatINR(oldDaAmount);
      dispNewBasic.innerText = formatINR(newBasic);
      dispOldHikeYield.innerText = formatINR(oldHikeYield) + ' / month';
      dispNewHikeYield.innerText = formatINR(newHikeYield) + ' / month';
      dispNetMonthlyAdvantage.innerText = '+ ' + formatINR(netAdvantage);
    }

    currentBasicInput.addEventListener('input', calculateDaDynamics);
    currentDaRateSelect.addEventListener('change', calculateDaDynamics);
    fitmentOptionSelect.addEventListener('change', calculateDaDynamics);
    futureHikeRateSelect.addEventListener('change', calculateDaDynamics);

    // Initial run
    calculateDaDynamics();
  </script>
</body>
</html>

