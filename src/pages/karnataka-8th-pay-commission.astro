  <!-- ==================== CLIENT SCRIPT: KARNATAKA SALARY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Karnataka Salary Calculation Engine
    const karScaleSelect = document.getElementById('karScaleSelect');
    const karCurrentBasic = document.getElementById('karCurrentBasic');
    const karFitmentSelect = document.getElementById('karFitmentSelect');
    const karCityTierSelect = document.getElementById('karCityTierSelect');
    const karPensionScheme = document.getElementById('karPensionScheme');

    const outKarRevisedBasic = document.getElementById('outKarRevisedBasic');
    const outKarHra = document.getElementById('outKarHra');
    const outKarMa = document.getElementById('outKarMa');
    const outKarCca = document.getElementById('outKarCca');
    const outKarGross = document.getElementById('outKarGross');
    const outKarPensionDeduct = document.getElementById('outKarPensionDeduct');
    const outKarFixedDeduct = document.getElementById('outKarFixedDeduct');
    const outKarNetTakeHome = document.getElementById('outKarNetTakeHome');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateKarSalary() {
      const basic = parseFloat(karCurrentBasic.value) || 0;
      const fitment = parseFloat(karFitmentSelect.value) || 2.28;
      const hraRate = parseFloat(karCityTierSelect.value) || 0.27;
      const pensionRate = parseFloat(karPensionScheme.value) || 0.10;

      // 1. Revised Basic Pay (rounded to nearest 100)
      const revisedBasic = Math.round((basic * fitment) / 100) * 100;

      // 2. House Rent Allowance (HRA) with Karnataka floor protection
      let calculatedHra = revisedBasic * hraRate;
      let floorLimit = 3690;
      if (hraRate >= 0.27) floorLimit = 11080;
      else if (hraRate >= 0.18) floorLimit = 7390;
      else if (hraRate >= 0.14) floorLimit = 5400;
      calculatedHra = Math.max(calculatedHra, floorLimit);

      // 3. Medical Allowance (Fixed ₹500 in Karnataka)
      const maAmount = 500;

      // 4. City Compensatory / Conveyance Allowance
      let ccaAmount = 600;
      if (hraRate >= 0.27) ccaAmount = 1200; // Bengaluru BBMP
      else if (hraRate >= 0.18) ccaAmount = 850; // Mysuru / Hubballi

      // 5. Estimated Gross Salary
      const grossSalary = revisedBasic + calculatedHra + maAmount + ccaAmount;

      // 6. Deductions: Pension 10% + KGID insurance + Professional Tax (~₹200)
      const pensionDeduction = revisedBasic * pensionRate;
      const fixedDeductions = 1400; // KGID life insurance + PT
      const totalDeductions = pensionDeduction + fixedDeductions;

      // 7. Net Take-Home Pay
      const netSalary = grossSalary - totalDeductions;

      // Update DOM
      outKarRevisedBasic.innerText = formatINR(revisedBasic);
      outKarHra.innerText = formatINR(calculatedHra);
      outKarMa.innerText = formatINR(maAmount);
      outKarCca.innerText = formatINR(ccaAmount);
      outKarGross.innerText = formatINR(grossSalary);
      outKarPensionDeduct.innerText = pensionDeduction > 0 ? ('- ' + formatINR(pensionDeduction)) : '₹0 (GPF)';
      outKarFixedDeduct.innerText = '- ' + formatINR(fixedDeductions);
      outKarNetTakeHome.innerText = formatINR(netSalary);
    }

    // Sync input when Karnataka Scale dropdown changes
    karScaleSelect.addEventListener('change', (e) => {
      karCurrentBasic.value = e.target.value;
      calculateKarSalary();
    });

    karCurrentBasic.addEventListener('input', calculateKarSalary);
    karFitmentSelect.addEventListener('change', calculateKarSalary);
    karCityTierSelect.addEventListener('change', calculateKarSalary);
    karPensionScheme.addEventListener('change', calculateKarSalary);

    // Initial run
    calculateKarSalary();
  </script>
