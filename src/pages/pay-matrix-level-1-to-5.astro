  <!-- ==================== CLIENT SCRIPT: LEVEL 1-5 SIMULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Level 1 to 5 Inspection Engine
    const selectLvlBand = document.getElementById('selectLvlBand');
    const fitmentFactorLvl = document.getElementById('fitmentFactorLvl');
    const cellIncrementIndex = document.getElementById('cellIncrementIndex');
    const cityTierOption = document.getElementById('cityTierOption');

    const dispCellBasic = document.getElementById('dispCellBasic');
    const dispOldReference = document.getElementById('dispOldReference');
    const dispHraValue = document.getElementById('dispHraValue');
    const dispTaValue = document.getElementById('dispTaValue');
    const dispGrossTotal = document.getElementById('dispGrossTotal');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateLevelCompensation() {
      const selectedOption = selectLvlBand.options[selectLvlBand.selectedIndex];
      const base7th = parseFloat(selectedOption.getAttribute('data-7th')) || 18000;
      const gp = selectedOption.getAttribute('data-gp') || '1800';
      const lvl = parseInt(selectLvlBand.value) || 1;
      const fitment = parseFloat(fitmentFactorLvl.value) || 2.28;
      const cellStep = parseInt(cellIncrementIndex.value) || 1;
      const hraRate = parseFloat(cityTierOption.value) || 0.27;

      // 1. Calculate Cell 1 Starting Base (rounded to nearest 100)
      const cellOne = Math.round((base7th * fitment) / 100) * 100;

      // 2. Compound vertically at 3% per annual increment step
      let currentCellPay = cellOne;
      for (let i = 1; i < cellStep; i++) {
        currentCellPay = Math.round((currentCellPay * 1.03) / 100) * 100;
      }

      // 3. Calculate HRA with statutory floor protection
      let calculatedHra = currentCellPay * hraRate;
      let floorLimit = 3690;
      if (hraRate >= 0.27) floorLimit = 11080;
      else if (hraRate >= 0.18) floorLimit = 7390;
      calculatedHra = Math.max(calculatedHra, floorLimit);

      // 4. Calculate Transport Allowance
      // Levels 1 and 2 = Band 3 TA; Levels 3 to 5 = Band 2 TA
      let baseTa = 1350;
      if (lvl >= 3) baseTa = 3600;
      if (hraRate < 0.18) baseTa = (lvl >= 3) ? 1800 : 900;
      const calculatedTa = baseTa * 1.80; // 8th CPC baseline expansion

      // 5. Calculate Gross Monthly Total
      const grossTotal = currentCellPay + calculatedHra + calculatedTa;

      // Update UI
      dispCellBasic.innerText = formatINR(currentCellPay);
      dispOldReference.innerText = `${formatINR(base7th)} (GP ₹${gp})`;
      dispHraValue.innerText = formatINR(calculatedHra);
      dispTaValue.innerText = formatINR(calculatedTa);
      dispGrossTotal.innerText = formatINR(grossTotal);
    }

    selectLvlBand.addEventListener('change', calculateLevelCompensation);
    fitmentFactorLvl.addEventListener('change', calculateLevelCompensation);
    cellIncrementIndex.addEventListener('change', calculateLevelCompensation);
    cityTierOption.addEventListener('change', calculateLevelCompensation);

    // Initial run
    calculateLevelCompensation();
  </script>
