  <!-- CLIENT-SIDE CALCULATION ENGINE -->
  <script is:inline>
    // Elements
    const payLevelSelect = document.getElementById('payLevelSelect');
    const basicPayInput = document.getElementById('basicPayInput');
    const fitmentButtons = document.querySelectorAll('.fitment-btn');
    const activeFitmentLabel = document.getElementById('activeFitmentLabel');
    const cityCategorySelect = document.getElementById('cityCategorySelect');
    const daRateSelect = document.getElementById('daRateSelect');

    // Outputs
    const grossSalaryText = document.getElementById('grossSalaryText');
    const monthlyGainBadge = document.getElementById('monthlyGainBadge');
    const curBasicText = document.getElementById('curBasicText');
    const revBasicText = document.getElementById('revBasicText');
    const revHraText = document.getElementById('revHraText');
    const revDaText = document.getElementById('revDaText');
    const revTaText = document.getElementById('revTaText');
    const annualGainText = document.getElementById('annualGainText');
    const revPensionText = document.getElementById('revPensionText');
    const revFamilyPensionText = document.getElementById('revFamilyPensionText');

    let currentFactor = 2.57;

    function formatINR(val) {
      return "₹ " + Math.round(val).toLocaleString('en-IN');
    }

    function calculatePay() {
      const basic7th = parseFloat(basicPayInput.value) || 18000;
      const hraRate = parseFloat(cityCategorySelect.value) || 0.20;
      const daRate = parseFloat(daRateSelect.value) || 0.00;

      // 7th CPC baseline gross estimate (assumes 50% DA in late 7th CPC + HRA)
      const currentDaEstimate = basic7th * 0.50;
      const currentHraEstimate = basic7th * hraRate;
      const currentTaEstimate = 1800;
      const currentGross = basic7th + currentDaEstimate + currentHraEstimate + currentTaEstimate;

      // 8th CPC projected basic
      const rawRevisedBasic = basic7th * currentFactor;
      // Round to nearest 100 as per Pay Commission matrix conventions
      const revisedBasic = Math.round(rawRevisedBasic / 100) * 100;

      // Revised allowances
      const revisedHra = Math.round(revisedBasic * hraRate);
      const revisedDa = Math.round(revisedBasic * daRate);
      
      // Estimated TA based on level
      const revisedTa = revisedBasic > 50000 ? 3600 : 2400;

      const revisedGross = revisedBasic + revisedHra + revisedDa + revisedTa;
      const monthlyGain = revisedGross - currentGross;
      const pctGain = ((monthlyGain / currentGross) * 100).toFixed(1);
      const annualGain = monthlyGain * 12;

      // Pension projections (50% and 30% of basic)
      const revisedPension = Math.round(revisedBasic * 0.50);
      const revisedFamilyPension = Math.round(revisedBasic * 0.30);

      // Render outputs
      grossSalaryText.innerText = formatINR(revisedGross);
      curBasicText.innerText = formatINR(basic7th);
      revBasicText.innerText = formatINR(revisedBasic);
      revHraText.innerText = formatINR(revisedHra);
      revDaText.innerText = formatINR(revisedDa);
      revTaText.innerText = formatINR(revisedTa);

      if (monthlyGain > 0) {
        monthlyGainBadge.innerText = `+ ${formatINR(monthlyGain)} (+${pctGain}%) Gain`;
        monthlyGainBadge.style.display = "inline-flex";
        annualGainText.innerText = `+ ${formatINR(annualGain)}`;
      } else {
        monthlyGainBadge.style.display = "none";
        annualGainText.innerText = formatINR(0);
      }

      revPensionText.innerText = `${formatINR(revisedPension)} / mo`;
      revFamilyPensionText.innerText = `${formatINR(revisedFamilyPension)} / mo`;
    }

    // Event Handlers
    payLevelSelect.addEventListener('change', (e) => {
      basicPayInput.value = e.target.value;
      calculatePay();
    });

    basicPayInput.addEventListener('input', calculatePay);
    cityCategorySelect.addEventListener('change', calculatePay);
    daRateSelect.addEventListener('change', calculatePay);

    fitmentButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        fitmentButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFactor = parseFloat(btn.getAttribute('data-factor'));
        activeFitmentLabel.innerText = `Active: ${currentFactor}`;
        calculatePay();
      });
    });

    // Initial calculation on load
    calculatePay();
  </script>

