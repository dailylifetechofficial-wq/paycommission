  <!-- ==================== CLIENT JAVASCRIPT ==================== -->
  <script is:inline>
    // Mobile navigation drawer toggle
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Salary Calculator Engine
    const basicPayInput = document.getElementById('basicPayInput');
    const cpcLevelSelect = document.getElementById('cpcLevel');
    const fitmentFactorSelect = document.getElementById('fitmentFactor');
    const cityTypeSelect = document.getElementById('cityType');

    const revisedBasicEl = document.getElementById('revisedBasic');
    const projectedHraEl = document.getElementById('projectedHra');
    const projectedTaEl = document.getElementById('projectedTa');
    const grossSalaryEl = document.getElementById('grossSalary');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculatePay() {
      const basic = parseFloat(basicPayInput.value) || 0;
      const factor = parseFloat(fitmentFactorSelect.value) || 2.28;
      const hraRate = parseFloat(cityTypeSelect.value) || 0.27;

      // 8th CPC Basic
      const revisedBasic = basic * factor;

      // HRA calculated on new basic
      const projectedHra = revisedBasic * hraRate;

      // Transport Allowance baseline
      const baseTa = basic >= 35400 ? 3600 : 1350;
      const projectedTa = baseTa * 1.6;

      // Gross Salary
      const gross = revisedBasic + projectedHra + projectedTa;

      revisedBasicEl.innerText = formatINR(revisedBasic);
      projectedHraEl.innerText = formatINR(projectedHra);
      projectedTaEl.innerText = formatINR(projectedTa);
      grossSalaryEl.innerText = formatINR(gross);
    }

    cpcLevelSelect.addEventListener('change', (e) => {
      basicPayInput.value = e.target.value;
      calculatePay();
    });

    basicPayInput.addEventListener('input', calculatePay);
    fitmentFactorSelect.addEventListener('change', calculatePay);
    cityTypeSelect.addEventListener('change', calculatePay);

    // Initial calculation run
    calculatePay();
  </script>
</head>
