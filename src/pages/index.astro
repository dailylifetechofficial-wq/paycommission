---
// src/pages/index.astro
const title = "₹ 8PayCommission: Expected Pay Matrix, Salary Calculator & Fitment Factor (2026)";
const description = "Calculate 8th Pay Commission salary, pay matrix level 1 to 18, fitment factor 2.28 vs 2.86, DA merger, and state revisions for TN, UP, Maharashtra, Rajasthan, Bihar, and WB.";
const canonicalURL = "https://8paycommission.com/";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0, maximum-scale=5.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="google-adsense-account" content="ca-pub-7557955393674418"> <!-- Added publisher meta -->
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  
  <!-- Schema Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "₹ 8PayCommission",
      "url": "https://8paycommission.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://8paycommission.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  <!-- ==================== PREMIUM ZERO-GAP RESPONSIVE STYLES ==================== -->
