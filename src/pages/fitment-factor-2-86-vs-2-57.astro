        </div>

      </div>

      <div class="footer-bottom">
        <p>© 2026 ₹ 8PayCommission.com. All Rights Reserved. Built for Central & State Government Employees.</p>
      </div>
    </div>
  </footer>

  <!-- ==================== CLIENT SCRIPT: DUAL SIMULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Dual Comparison Simulation Engine
    const cadreSelect = document.getElementById('cadreSelect');
    const basicPayInput = document.getElementById('basicPayInput');
    const cityTierSelect = document.getElementById('cityTierSelect');

    const dispPay257 = document.getElementById('dispPay257');
    const dispPay286 = document.getElementById('dispPay286');
    const dispBasicDiff = document.getElementById('dispBasicDiff');
    const dispHraDiff = document.getElementById('dispHraDiff');
    const dispTotalAdvantage = document.getElementById('dispTotalAdvantage');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateComparison() {
      const basic = parseFloat(basicPayInput.value) || 0;
      const hraRate = parseFloat(cityTierSelect.value) || 0.27;

      // 1. Basic under 2.57
      const basic257 = basic * 2.57;

      // 2. Basic under 2.86
      const basic286 = basic * 2.86;

      // 3. Difference in basic
      const basicDiff = basic286 - basic257;

      // 4. Difference in HRA
      const hra257 = basic257 * hraRate;
      const hra286 = basic286 * hraRate;
      const hraDiff = hra286 - hra257;

      // 5. Total gross monthly advantage
      const totalAdvantage = basicDiff + hraDiff;

      // Update DOM
      dispPay257.innerText = formatINR(basic257);
      dispPay286.innerText = formatINR(basic286);
      dispBasicDiff.innerText = '+ ' + formatINR(basicDiff);
      dispHraDiff.innerText = '+ ' + formatINR(hraDiff);
      dispTotalAdvantage.innerText = '+ ' + formatINR(totalAdvantage);
    }

    cadreSelect.addEventListener('change', (e) => {
      basicPayInput.value = e.target.value;
      calculateComparison();
    });

    basicPayInput.addEventListener('input', calculateComparison);
    cityTierSelect.addEventListener('change', calculateComparison);

    // Initial run
    calculateComparison();
  </script>
</body>
