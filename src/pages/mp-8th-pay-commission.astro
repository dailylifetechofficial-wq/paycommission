  <!-- ==================== CLIENT SCRIPT: MP SALARY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Madhya Pradesh Salary Calculation Engine
    const mpCadreSelect = document.getElementById('mpCadreSelect');
    const mpCurrentBasic = document.getElementById('mpCurrentBasic');
    const mpFitmentSelect = document.getElementById('mpFitmentSelect');
    const mpCityCategorySelect = document.getElementById('mpCityCategorySelect');
    const mpPensionScheme = document.getElementById('mpPensionScheme');

    const outMpRevisedBasic = document.getElementById('outMpRevisedBasic');
    const outMpHra = document.getElementById('outMpHra');
    const outMpMa = document.getElementById('outMpMa');
    const outMpTa = document.getElementById('outMpTa');
    const outMpGross = document.getElementById('outMpGross');
    const outMpPensionDeduct = document.getElementById('outMpPensionDeduct');
    const outMpFixedDeduct = document.getElementById('outMpFixedDeduct');
    const outMpNetTakeHome = document.getElementById('outMpNetTakeHome');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateMpSalary() {
      const basic = parseFloat(mpCurrentBasic.value) || 0;
      const fitment = parseFloat(mpFitmentSelect.value) || 2.28;
      const hraRate = parseFloat(mpCityCategorySelect.value) || 0.16;
      const pensionRate = parseFloat(mpPensionScheme.value) || 0.10;

      // 1. Revised Basic Pay (rounded to nearest 100)
      const revisedBasic = Math.round((basic * fitment) / 100) * 100;

      // 2. House Rent Allowance (HRA) with MP floor protection
      let calculatedHra = revisedBasic * hraRate;
      let floorLimit = 3690;
      if (hraRate >= 0.16) floorLimit = 7390;
      else if (hraRate >= 0.08) floorLimit = 3690;
      calculatedHra = Math.max(calculatedHra, floorLimit);

      // 3. Fixed Medical Allowance in MP
      const maAmount = 500;

      // 4. Transport Allowance (TA estimation)
      const selectedOption = mpCadreSelect.options[mpCadreSelect.selectedIndex];
      const levelAttr = parseInt(selectedOption.getAttribute('data-level')) || 4;
      let baseTa = (levelAttr >= 12) ? 3600 : (levelAttr >= 4 ? 1800 : 900);
      if (hraRate >= 0.16) baseTa = baseTa * 1.5; // Bhopal / Indore urban higher TA
      const calculatedTa = baseTa * 1.60;

      // 5. Estimated Gross Salary
      const grossSalary = revisedBasic + calculatedHra + maAmount + calculatedTa;

      // 6. Deductions: Pension 10% + GIS + Professional Tax (PT ~₹208)
      const pensionDeduction = revisedBasic * pensionRate;
      const fixedDeductions = 408; // GIS + MP Professional Tax
      const totalDeductions = pensionDeduction + fixedDeductions;

      // 7. Net Take-Home Pay
      const netSalary = grossSalary - totalDeductions;

      // Update DOM
      outMpRevisedBasic.innerText = formatINR(revisedBasic);
      outMpHra.innerText = formatINR(calculatedHra);
      outMpMa.innerText = formatINR(maAmount);
      outMpTa.innerText = formatINR(calculatedTa);
      outMpGross.innerText = formatINR(grossSalary);
      outMpPensionDeduct.innerText = pensionDeduction > 0 ? ('- ' + formatINR(pensionDeduction)) : '₹0 (GPF)';
      outMpFixedDeduct.innerText = '- ' + formatINR(fixedDeductions);
      outMpNetTakeHome.innerText = formatINR(netSalary);
    }

    // Sync input when MP Cadre dropdown changes
    mpCadreSelect.addEventListener('change', (e) => {
      mpCurrentBasic.value = e.target.value;
      calculateMpSalary();
    });

    mpCurrentBasic.addEventListener('input', calculateMpSalary);
    mpFitmentSelect.addEventListener('change', calculateMpSalary);
    mpCityCategorySelect.addEventListener('change', calculateMpSalary);
    mpPensionScheme.addEventListener('change', calculateMpSalary);

    // Initial run
    calculateMpSalary();
  </script>
</body>
