  <!-- ==================== CLIENT SCRIPT: RAJASTHAN SALARY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Rajasthan Salary Calculation Engine
    const rjLevelSelect = document.getElementById('rjLevelSelect');
    const rjProbationStatus = document.getElementById('rjProbationStatus');
    const rjCurrentBasic = document.getElementById('rjCurrentBasic');
    const rjFitmentSelect = document.getElementById('rjFitmentSelect');
    const rjCityTierSelect = document.getElementById('rjCityTierSelect');
    const basicPayInputBlock = document.getElementById('basicPayInputBlock');

    const labelOutputPrimary = document.getElementById('labelOutputPrimary');
    const outRjRevisedBasic = document.getElementById('outRjRevisedBasic');
    const outRjHra = document.getElementById('outRjHra');
    const outRjCa = document.getElementById('outRjCa');
    const outRjGross = document.getElementById('outRjGross');
    const outRjGpfDeduct = document.getElementById('outRjGpfDeduct');
    const outRjSiDeduct = document.getElementById('outRjSiDeduct');
    const outRjNetTakeHome = document.getElementById('outRjNetTakeHome');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateRjSalary() {
      const isProbation = rjProbationStatus.value === 'probation';
      const selectedOption = rjLevelSelect.options[rjLevelSelect.selectedIndex];
      const base7th = parseFloat(selectedOption.value) || 20800;
      const prob7th = parseFloat(selectedOption.getAttribute('data-prob')) || 13500;
      const fitment = parseFloat(rjFitmentSelect.value) || 2.28;
      const hraRate = parseFloat(rjCityTierSelect.value) || 0.18;

      if (isProbation) {
        // Probation Trainee Mode: Fixed remuneration without HRA/DA
        basicPayInputBlock.style.opacity = '0.5';
        labelOutputPrimary.innerText = 'Revised 8th CPC Probation Pay:';

        const revisedProbationPay = Math.round((prob7th * fitment) / 100) * 100;
        const hraAmount = 0;
        const caAmount = 0;
        const grossSalary = revisedProbationPay;

        // Minor deductions during probation (RGHS medical only)
        const gpfDeduct = 0;
        const siDeduct = 440; // RGHS slab deduction
        const netSalary = grossSalary - siDeduct;

        outRjRevisedBasic.innerText = formatINR(revisedProbationPay);
        outRjHra.innerText = '₹0 (No HRA in Probation)';
        outRjCa.innerText = '₹0';
        outRjGross.innerText = formatINR(grossSalary);
        outRjGpfDeduct.innerText = '₹0';
        outRjSiDeduct.innerText = '- ' + formatINR(siDeduct);
        outRjNetTakeHome.innerText = formatINR(netSalary);
      } else {
        // Regular Employee Mode: Full Basic + HRA + Deductions
        basicPayInputBlock.style.opacity = '1.0';
        labelOutputPrimary.innerText = 'Revised RJ 8th CPC Basic Pay:';

        const rawBasic = parseFloat(rjCurrentBasic.value) || base7th;
        const revisedBasic = Math.round((rawBasic * fitment) / 100) * 100;

        // HRA with statutory floor protection
        let calculatedHra = revisedBasic * hraRate;
        let floorLimit = (hraRate >= 0.18) ? 7390 : 3690;
        calculatedHra = Math.max(calculatedHra, floorLimit);

        // Fixed City Conveyance Allowance
        const caAmount = 620;

        // Estimated Gross Salary
        const grossSalary = revisedBasic + calculatedHra + caAmount;

        // Deductions: GPF slab contribution + State Insurance (SI) + RGHS
        const gpfDeduct = Math.max(2100, Math.round(revisedBasic * 0.06));
        const siDeduct = 1825; // SI slab + RGHS medical fund
        const totalDeductions = gpfDeduct + siDeduct;

        // Net Take-Home Pay
        const netSalary = grossSalary - totalDeductions;

        outRjRevisedBasic.innerText = formatINR(revisedBasic);
        outRjHra.innerText = formatINR(calculatedHra);
        outRjCa.innerText = formatINR(caAmount);
        outRjGross.innerText = formatINR(grossSalary);
        outRjGpfDeduct.innerText = '- ' + formatINR(gpfDeduct);
        outRjSiDeduct.innerText = '- ' + formatINR(siDeduct);
        outRjNetTakeHome.innerText = formatINR(netSalary);
      }
    }

    // Sync input when level selection changes
    rjLevelSelect.addEventListener('change', (e) => {
      rjCurrentBasic.value = e.target.value;
      calculateRjSalary();
    });

    rjProbationStatus.addEventListener('change', calculateRjSalary);
    rjCurrentBasic.addEventListener('input', calculateRjSalary);
    rjFitmentSelect.addEventListener('change', calculateRjSalary);
    rjCityTierSelect.addEventListener('change', calculateRjSalary);

    // Initial run
    calculateRjSalary();
  </script>
</body>
