  <!-- ==================== CLIENT SCRIPT: PENSION CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Pension Calculator Engine
    const pensionLevelCategory = document.getElementById('pensionLevelCategory');
    const currentBasicPensionInput = document.getElementById('currentBasicPensionInput');
    const fitmentSelect = document.getElementById('fitmentSelect');
    const commutationPercentSelect = document.getElementById('commutationPercentSelect');
    const ageTierBonusSelect = document.getElementById('ageTierBonusSelect');
    const fmaMedicalSelect = document.getElementById('fmaMedicalSelect');

    const outRevisedBasicPension = document.getElementById('outRevisedBasicPension');
    const outAgeTopupValue = document.getElementById('outAgeTopupValue');
    const outGrossUnreduced = document.getElementById('outGrossUnreduced');
    const outCommutationCut = document.getElementById('outCommutationCut');
    const outFmaCredit = document.getElementById('outFmaCredit');
    const outNetTakeHomePension = document.getElementById('outNetTakeHomePension');

    function formatCurrency(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculatePensionPlan() {
      const basic = parseFloat(currentBasicPensionInput.value) || 0;
      const fitment = parseFloat(fitmentSelect.value) || 2.28;
      const commuteRate = (parseFloat(commutationPercentSelect.value) || 0) / 100;
      const ageRate = parseFloat(ageTierBonusSelect.value) || 0;
      const fmaAmount = parseFloat(fmaMedicalSelect.value) || 0;

      // 1. Revised Basic Pension
      const revisedBasic = basic * fitment;

      // 2. Age-Based Supplementary Top-Up
      const ageTopup = revisedBasic * ageRate;

      // 3. Unreduced Gross (Basic + Age Bonus)
      const grossUnreduced = revisedBasic + ageTopup;

      // 4. Commutation Monthly Deduction
      const commuteCut = revisedBasic * commuteRate;

      // 5. Net Monthly Take-Home (Gross - Commutation + FMA)
      const netTakeHome = (grossUnreduced - commuteCut) + fmaAmount;

      // Update UI
      outRevisedBasicPension.innerText = formatCurrency(revisedBasic);
      outAgeTopupValue.innerText = ageTopup > 0 ? ('+ ' + formatCurrency(ageTopup)) : '₹0';
      outGrossUnreduced.innerText = formatCurrency(grossUnreduced);
      outCommutationCut.innerText = commuteCut > 0 ? ('- ' + formatCurrency(commuteCut)) : '₹0';
      outFmaCredit.innerText = fmaAmount > 0 ? ('+ ' + formatCurrency(fmaAmount)) : '₹0 (CGHS)';
      outNetTakeHomePension.innerText = formatCurrency(netTakeHome);
    }

    // Sync basic pension when pay level changes
    pensionLevelCategory.addEventListener('change', (e) => {
      currentBasicPensionInput.value = e.target.value;
      calculatePensionPlan();
    });

    currentBasicPensionInput.addEventListener('input', calculatePensionPlan);
    fitmentSelect.addEventListener('change', calculatePensionPlan);
    commutationPercentSelect.addEventListener('change', calculatePensionPlan);
    ageTierBonusSelect.addEventListener('change', calculatePensionPlan);
    fmaMedicalSelect.addEventListener('change', calculatePensionPlan);

    // Initial calculation run
    calculatePensionPlan();
  </script>
</body>
</html>

