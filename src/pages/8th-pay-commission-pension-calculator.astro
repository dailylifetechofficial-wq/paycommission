  <!-- ==================== CLIENT SCRIPT: PENSION CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Pension Calculation Engine
    const pensionerStatus = document.getElementById('pensionerStatus');
    const pensionBaseInput = document.getElementById('pensionBaseInput');
    const labelPensionBase = document.getElementById('labelPensionBase');
    const notePensionBase = document.getElementById('notePensionBase');
    const pensionFitmentSelect = document.getElementById('pensionFitmentSelect');
    const commutationRate = document.getElementById('commutationRate');
    const ageTopupSelect = document.getElementById('ageTopupSelect');
    const fmaMedicalSelect = document.getElementById('fmaMedicalSelect');

    const outFullBasic = document.getElementById('outFullBasic');
    const outAgeTopup = document.getElementById('outAgeTopup');
    const outCommutationCut = document.getElementById('outCommutationCut');
    const outFmaValue = document.getElementById('outFmaValue');
    const outFamilyPension = document.getElementById('outFamilyPension');
    const outNetTakeHome = document.getElementById('outNetTakeHome');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculatePensionValues() {
      const isPastPensioner = pensionerStatus.value === 'past';
      const rawInput = parseFloat(pensionBaseInput.value) || 0;
      const fitment = parseFloat(pensionFitmentSelect.value) || 2.28;
      const commuteFraction = parseFloat(commutationRate.value) || 0.00;
      const ageTopupFraction = parseFloat(ageTopupSelect.value) || 0.00;
      const fmaAmount = parseFloat(fmaMedicalSelect.value) || 0;

      // 1. Determine Revised 8th CPC Full Basic Pension
      let revisedFullBasic = 0;
      if (isPastPensioner) {
        // Direct multiplication on existing PPO basic
        revisedFullBasic = rawInput * fitment;
      } else {
        // Fresh retiree: 50% of the revised last basic pay
        const revisedLastBasic = rawInput * fitment;
        revisedFullBasic = revisedLastBasic * 0.50;
      }

      // Enforce projected minimum pension floor (approx ₹20,520 at 2.28x)
      const minimumFloor = Math.max(9000, 9000 * (fitment / 1.0));
      revisedFullBasic = Math.max(revisedFullBasic, minimumFloor);

      // 2. Age-based supplementary top-up
      const ageTopupAmount = revisedFullBasic * ageTopupFraction;

      // 3. Commuted deduction portion
      const commutationDeduction = revisedFullBasic * commuteFraction;

      // 4. Assured Family Pension (60% of basic pension)
      const familyPension = revisedFullBasic * 0.60;

      // 5. Net Monthly Take-Home (Bank Credit)
      // Net = (Revised Basic + Age Topup - Commutation) + FMA
      const netMonthlyPension = (revisedFullBasic + ageTopupAmount - commutationDeduction) + fmaAmount;

      // Update DOM
      outFullBasic.innerText = formatINR(revisedFullBasic);
      outAgeTopup.innerText = ageTopupAmount > 0 ? ('+ ' + formatINR(ageTopupAmount)) : '₹0';
      outCommutationCut.innerText = commutationDeduction > 0 ? ('- ' + formatINR(commutationDeduction)) : '- ₹0';
      outFmaValue.innerText = formatINR(fmaAmount);
      outFamilyPension.innerText = formatINR(familyPension);
      outNetTakeHome.innerText = formatINR(netMonthlyPension);
    }

    // Toggle input labels when switching between existing pensioner and fresh retiree
    pensionerStatus.addEventListener('change', () => {
      if (pensionerStatus.value === 'past') {
        labelPensionBase.innerText = 'Current 7th CPC Basic Pension (₹):';
        notePensionBase.innerText = 'Enter the basic pension drawn on your current PPO (excluding Dearness Relief).';
        pensionBaseInput.value = '25000';
      } else {
        labelPensionBase.innerText = 'Projected 7th CPC Last Basic Pay (₹):';
        notePensionBase.innerText = 'Enter your anticipated last drawn basic pay prior to retirement.';
        pensionBaseInput.value = '65000';
      }
      calculatePensionValues();
    });

    pensionBaseInput.addEventListener('input', calculatePensionValues);
    pensionFitmentSelect.addEventListener('change', calculatePensionValues);
    commutationRate.addEventListener('change', calculatePensionValues);
    ageTopupSelect.addEventListener('change', calculatePensionValues);
    fmaMedicalSelect.addEventListener('change', calculatePensionValues);

    // Initial run
    calculatePensionValues();
  </script>
</body>
