          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Transport Allowance Calculation Engine
    const cadreBandSelect = document.getElementById('cadreBandSelect');
    const cityTierSelect = document.getElementById('cityTierSelect');
    const fitmentOption = document.getElementById('fitmentOption');
    const daCycleSelect = document.getElementById('daCycleSelect');
    const disabilitySelect = document.getElementById('disabilitySelect');

    const dispBaseTa = document.getElementById('dispBaseTa');
    const dispDaPortion = document.getElementById('dispDaPortion');
    const dispCityLabel = document.getElementById('dispCityLabel');
    const dispPwdStatus = document.getElementById('dispPwdStatus');
    const dispTotalTa = document.getElementById('dispTotalTa');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateTransportAllowance() {
      const cadre = cadreBandSelect.value;
      const city = cityTierSelect.value;
      const multiplier = parseFloat(fitmentOption.value) || 1.80;
      const daRate = parseFloat(daCycleSelect.value) || 0.00;
      const isPwd = disabilitySelect.value === 'yes';

      // 1. Establish 7th CPC baseline rate
      let base7th = 3600;
      if (cadre === 'high') {
        base7th = (city === 'higher') ? 7200 : 3600;
      } else if (cadre === 'mid') {
        base7th = (city === 'higher') ? 3600 : 1800;
      } else {
        base7th = (city === 'higher') ? 1350 : 900;
      }

      // 2. Compute 8th CPC Base TA
      let base8th = base7th * multiplier;

      // 3. Double TA for PwD
      const pwdFactor = isPwd ? 2.0 : 1.0;
      base8th = base8th * pwdFactor;

      // 4. DA portion
      const daAmount = base8th * daRate;

      // 5. Total payable
      const totalPayable = base8th + daAmount;

      // Update UI elements
      dispBaseTa.innerText = formatINR(base8th);
      dispDaPortion.innerText = daRate > 0 ? (formatINR(daAmount) + ` (${(daRate * 100).toFixed(0)}%)`) : '₹0 (0% Merged)';
      dispCityLabel.innerText = city === 'higher' ? 'Higher TPTA (19 Metros)' : 'Other Places (Standard)';
      dispPwdStatus.innerText = isPwd ? '2.0x (Double TA Concession)' : '1.0x (Standard)';
      dispTotalTa.innerText = formatINR(totalPayable);
    }

    cadreBandSelect.addEventListener('change', calculateTransportAllowance);
    cityTierSelect.addEventListener('change', calculateTransportAllowance);
    fitmentOption.addEventListener('change', calculateTransportAllowance);
    daCycleSelect.addEventListener('change', calculateTransportAllowance);
    disabilitySelect.addEventListener('change', calculateTransportAllowance);

    // Initial run
    calculateTransportAllowance();
  </script>
</body>
</html>

