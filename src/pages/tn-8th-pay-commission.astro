  <!-- ==================== CLIENT SCRIPT: TN SALARY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Tamil Nadu Salary Calculation Engine
    const tnLevelSelect = document.getElementById('tnLevelSelect');
    const tnCurrentBasic = document.getElementById('tnCurrentBasic');
    const tnFitmentSelect = document.getElementById('tnFitmentSelect');
    const tnCityGradeSelect = document.getElementById('tnCityGradeSelect');
    const tnPensionScheme = document.getElementById('tnPensionScheme');

    const outTnRevisedBasic = document.getElementById('outTnRevisedBasic');
    const outTnHra = document.getElementById('outTnHra');
    const outTnCca = document.getElementById('outTnCca');
    const outTnMa = document.getElementById('outTnMa');
    const outTnGross = document.getElementById('outTnGross');
    const outTnPensionDeduct = document.getElementById('outTnPensionDeduct');
    const outTnFixedDeduct = document.getElementById('outTnFixedDeduct');
    const outTnNetTakeHome = document.getElementById('outTnNetTakeHome');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateTnSalary() {
      const basic = parseFloat(tnCurrentBasic.value) || 0;
      const fitment = parseFloat(tnFitmentSelect.value) || 2.28;
      const hraRate = parseFloat(tnCityGradeSelect.value) || 0.27;
      const pensionRate = parseFloat(tnPensionScheme.value) || 0.10;

      // 1. Revised Basic Pay (rounded to nearest 100)
      const revisedBasic = Math.round((basic * fitment) / 100) * 100;

      // 2. House Rent Allowance (HRA) with TN floor protection
      let calculatedHra = revisedBasic * hraRate;
      let floorLimit = 3690;
      if (hraRate >= 0.27) floorLimit = 11080;
      else if (hraRate >= 0.18) floorLimit = 7390;
      else if (hraRate >= 0.12) floorLimit = 5200;
      calculatedHra = Math.max(calculatedHra, floorLimit);

      // 3. City Compensatory Allowance (CCA in TN)
      let ccaAmount = 0;
      if (hraRate >= 0.27) ccaAmount = 1000; // Chennai Metro
      else if (hraRate >= 0.18) ccaAmount = 600; // Coimbatore, Madurai

      // 4. Standard Medical Allowance (MA)
      const maAmount = 300;

      // 5. Estimated Gross Salary
      const grossSalary = revisedBasic + calculatedHra + ccaAmount + maAmount;

      // 6. Deductions
      const pensionDeduction = revisedBasic * pensionRate;
      const fixedDeductions = 420; // NHIS (New Health Insurance Scheme) + SPF + Family Benefit Fund
      const totalDeductions = pensionDeduction + fixedDeductions;

      // 7. Net Take-Home Pay
      const netSalary = grossSalary - totalDeductions;

      // Update DOM
      outTnRevisedBasic.innerText = formatINR(revisedBasic);
      outTnHra.innerText = formatINR(calculatedHra);
      outTnCca.innerText = formatINR(ccaAmount);
      outTnMa.innerText = formatINR(maAmount);
      outTnGross.innerText = formatINR(grossSalary);
      outTnPensionDeduct.innerText = pensionDeduction > 0 ? ('- ' + formatINR(pensionDeduction)) : '₹0 (GPF)';
      outTnFixedDeduct.innerText = '- ' + formatINR(fixedDeductions);
      outTnNetTakeHome.innerText = formatINR(netSalary);
    }

    // Sync input when TN Level dropdown changes
    tnLevelSelect.addEventListener('change', (e) => {
      tnCurrentBasic.value = e.target.value;
      calculateTnSalary();
    });

    tnCurrentBasic.addEventListener('input', calculateTnSalary);
    tnFitmentSelect.addEventListener('change', calculateTnSalary);
    tnCityGradeSelect.addEventListener('change', calculateTnSalary);
    tnPensionScheme.addEventListener('change', calculateTnSalary);

    // Initial run
    calculateTnSalary();
  </script>
