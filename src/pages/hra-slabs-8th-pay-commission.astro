  <!-- ==================== CLIENT SCRIPT: HRA ESTIMATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time HRA Estimator Engine
    const payLevelInput = document.getElementById('payLevelInput');
    const currentBasicPay = document.getElementById('currentBasicPay');
    const fitmentMultiplier = document.getElementById('fitmentMultiplier');
    const cityCategoryInput = document.getElementById('cityCategoryInput');

    const dispNewBasic = document.getElementById('dispNewBasic');
    const dispHraRate = document.getElementById('dispHraRate');
    const dispRawHra = document.getElementById('dispRawHra');
    const dispFloorLimit = document.getElementById('dispFloorLimit');
    const dispPayableHra = document.getElementById('dispPayableHra');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateHraEntitlement() {
      const basic = parseFloat(currentBasicPay.value) || 0;
      const fitment = parseFloat(fitmentMultiplier.value) || 2.28;
      const hraRate = parseFloat(cityCategoryInput.value) || 0.27;

      // 1. Revised Basic Pay
      const newBasic = basic * fitment;

      // 2. Mathematical HRA
      const rawHra = newBasic * hraRate;

      // 3. Minimum Floor Limits (Projected 8th CPC Floors: approx 2.05x of 7th CPC)
      let floorLimit = 3690;
      let tierLabel = '9% (Class Z)';
      if (hraRate >= 0.27) {
        floorLimit = 11080;
        tierLabel = '27% (Class X)';
      } else if (hraRate >= 0.18) {
        floorLimit = 7390;
        tierLabel = '18% (Class Y)';
      }

      // 4. Payable HRA: Greater of mathematical calculation or floor guarantee
      const payableHra = Math.max(rawHra, floorLimit);

      // Update DOM
      dispNewBasic.innerText = formatINR(newBasic);
      dispHraRate.innerText = tierLabel;
      dispRawHra.innerText = formatINR(rawHra);
      dispFloorLimit.innerText = formatINR(floorLimit) + ' / month';
      dispPayableHra.innerText = formatINR(payableHra);
    }

    // Sync input when pay level dropdown changes
    payLevelInput.addEventListener('change', (e) => {
      currentBasicPay.value = e.target.value;
      calculateHraEntitlement();
    });

    currentBasicPay.addEventListener('input', calculateHraEntitlement);
    fitmentMultiplier.addEventListener('change', calculateHraEntitlement);
    cityCategoryInput.addEventListener('change', calculateHraEntitlement);

    // Initial calculation run
    calculateHraEntitlement();
  </script>
