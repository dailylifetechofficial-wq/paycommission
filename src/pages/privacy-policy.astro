---
// src/pages/privacy-policy.astro
const title = "Privacy Policy - 8PayCommission.com (2026)";
const description = "Privacy Policy for 8PayCommission.com. Learn how we handle data, our zero-storage calculator standards, cookie policies, and advertising disclosures.";
const canonicalURL = "https://8paycommission.com/privacy-policy";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "8PayCommission",
          "url": "https://8paycommission.com",
          "logo": "https://8paycommission.com/favicon.svg",
          "email": "dailylifetech.official@gmail.com"
        },
        {
          "@type": "WebPage",
          "name": "Privacy Policy - 8PayCommission",
          "url": "https://8paycommission.com/privacy-policy",
          "description": "Comprehensive privacy policy, cookie disclosures, and advertising practices for 8PayCommission.com."
        }
      ]
    }
  </script>
</head>
