const title = "Privacy Policy - 8PayCommission.com | Data Protection & Cookies (2026)";
const description = "Read the Privacy Policy of 8PayCommission.com. Learn about our client-side zero-tracking policy, Google AdSense cookie usage, GDPR/CCPA rights, and user data protection.";
