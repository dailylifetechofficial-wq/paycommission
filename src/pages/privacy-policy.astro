---
// src/pages/contact-us.astro
const title = "Contact Us - 8PayCommission.com | Support & Editorial Inquiries (2026)";
const description = "Get in touch with 8PayCommission.com. Submit calculation feedback, editorial inquiries, Government Order updates, or technical support questions.";
const canonicalUrl = "https://8paycommission.com/contact-us/";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="googlebot" content="noindex, nofollow" />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  
  <!-- Structured Data: ContactPage & Organization Schema for AdSense Trust -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "8PayCommission",
          "url": "https://8paycommission.com",
          "logo": "https://8paycommission.com/favicon.svg",
          "email": "dailylifetech.official@gmail.com",
          "description": "Independent analytical and financial education portal dedicated to civil service compensation, pay matrices, pension modeling, and Pay Commission developments across India."
        },
        {
          "@type": "ContactPage",
          "name": "Contact Us - 8PayCommission",
          "url": "https://8paycommission.com/contact-us/",
          "description": "Contact channels and editorial communication desk for 8PayCommission.com."
        }
      ]
    }
  </script>
</head>

<body>
