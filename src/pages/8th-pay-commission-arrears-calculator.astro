  <!-- ==================== CLIENT SCRIPT: ARREARS CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Interactive Arrears Calculation Engine
    const calcLevelSelect = document.getElementById('calcLevelSelect');
    const calcBasicInput = document.getElementById('calcBasicInput');
    const calcFitmentSelect = document.getElementById('calcFitmentSelect');
    const monthsRetroactive = document.getElementById('monthsRetroactive');
    const daDrawnBaseline = document.getElementById('daDrawnBaseline');

    const resRevisedBasic = document.getElementById('resRevisedBasic');
    const resGrossDiff = document.getElementById('resGrossDiff');
    const resDaOffset = document.getElementById('resDaOffset');
    const resNetMonthlyDiff = document.getElementById('resNetMonthlyDiff');
    const resTotalBasicArrears = document.getElementById('resTotalBasicArrears');
    const resAllowanceArrears = document.getElementById('resAllowanceArrears');
    const resNpsDeduction = document.getElementById('resNpsDeduction');
    const resTotalNetArrears = document.getElementById('resTotalNetArrears');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function computeArrears() {
      const currentBasic = parseFloat(calcBasicInput.value) || 0;
      const fitment = parseFloat(calcFitmentSelect.value) || 2.28;
      const months = parseInt(monthsRetroactive.value) || 18;
      const daRate = parseFloat(daDrawnBaseline.value) || 0.53;

      // 1. Revised Monthly Basic
      const newBasic = currentBasic * fitment;

      // 2. Gross Basic Pay Monthly Difference
      const grossMonthlyDiff = newBasic - currentBasic;

      // 3. DA Already Drawn Monthly Offset
      const daDrawnMonthly = currentBasic * daRate;

      // 4. Net Monthly Basic Increment
      const netMonthlyDiff = Math.max(0, grossMonthlyDiff - daDrawnMonthly);

      // 5. Total Basic Pay Arrears over period
      const totalBasicArrears = netMonthlyDiff * months;

      // 6. Allowance differential estimation (approx 15% of basic difference)
      const totalAllowanceArrears = totalBasicArrears * 0.15;

      // 7. Mandatory Pension Deduction (NPS/UPS 10% on basic arrears)
      const npsDeduction = totalBasicArrears * 0.10;

      // 8. Net Estimated Take-Home Arrears
      const finalNetArrears = (totalBasicArrears + totalAllowanceArrears) - npsDeduction;

      // Update UI
      resRevisedBasic.innerText = formatINR(newBasic);
      resGrossDiff.innerText = '+ ' + formatINR(grossMonthlyDiff);
      resDaOffset.innerText = '- ' + formatINR(daDrawnMonthly);
      resNetMonthlyDiff.innerText = formatINR(netMonthlyDiff);
      resTotalBasicArrears.innerText = formatINR(totalBasicArrears);
      resAllowanceArrears.innerText = '+ ' + formatINR(totalAllowanceArrears);
      resNpsDeduction.innerText = '- ' + formatINR(npsDeduction);
      resTotalNetArrears.innerText = formatINR(finalNetArrears);
    }

    // Sync basic pay when level changes
    calcLevelSelect.addEventListener('change', (e) => {
      calcBasicInput.value = e.target.value;
      computeArrears();
    });

    calcBasicInput.addEventListener('input', computeArrears);
    calcFitmentSelect.addEventListener('change', computeArrears);
    monthsRetroactive.addEventListener('change', computeArrears);
    daDrawnBaseline.addEventListener('change', computeArrears);

    // Initial calculation run
    computeArrears();
  </script>
</body>
</html>

