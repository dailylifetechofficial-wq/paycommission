  <!-- ==================== CLIENT SCRIPT: ARREARS CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Arrears Calculation Engine
    const arrearsPayLevel = document.getElementById('arrearsPayLevel');
    const currentBasicDrawn = document.getElementById('currentBasicDrawn');
    const arrearsFitmentSelect = document.getElementById('arrearsFitmentSelect');
    const arrearsMonthsCount = document.getElementById('arrearsMonthsCount');
    const drawnDaRate = document.getElementById('drawnDaRate');
    const pensionDeductCheck = document.getElementById('pensionDeductCheck');

    const outRevisedBasic = document.getElementById('outRevisedBasic');
    const outBasicDifference = document.getElementById('outBasicDifference');
    const outDaAdjustment = document.getElementById('outDaAdjustment');
    const outMonthlyNetArrear = document.getElementById('outMonthlyNetArrear');
    const outGrossArrears = document.getElementById('outGrossArrears');
    const outNpsDeduction = document.getElementById('outNpsDeduction');
    const outNetLumpSum = document.getElementById('outNetLumpSum');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateArrears() {
      const basic = parseFloat(currentBasicDrawn.value) || 0;
      const fitment = parseFloat(arrearsFitmentSelect.value) || 2.28;
      const months = Math.max(1, parseInt(arrearsMonthsCount.value) || 12);
      const daDrawnRate = parseFloat(drawnDaRate.value) || 0.53;
      const npsRate = parseFloat(pensionDeductCheck.value) || 0.10;

      // 1. Revised Basic Pay (rounded to nearest 100)
      const revisedBasic = Math.round((basic * fitment) / 100) * 100;

      // 2. Monthly Basic Difference
      const basicDiff = revisedBasic - basic;

      // 3. DA Already Drawn Portion (to be adjusted)
      const drawnDaAmount = basic * daDrawnRate;

      // 4. Net Monthly Arrear (Revised Basic - [Old Basic + Old DA])
      const monthlyNetArrear = Math.max(0, revisedBasic - (basic + drawnDaAmount));

      // 5. Cumulative Gross Arrears over elapsed months
      const grossArrears = monthlyNetArrear * months;

      // 6. NPS/UPS 10% Pension Deduction Adjustment
      const npsDeduction = grossArrears * npsRate;

      // 7. Net Lump-Sum Payable
      const netPayable = grossArrears - npsDeduction;

      // Update UI
      outRevisedBasic.innerText = formatINR(revisedBasic);
      outBasicDifference.innerText = '+ ' + formatINR(basicDiff);
      outDaAdjustment.innerText = '- ' + formatINR(drawnDaAmount);
      outMonthlyNetArrear.innerText = formatINR(monthlyNetArrear);
      outGrossArrears.innerText = formatINR(grossArrears);
      outNpsDeduction.innerText = npsDeduction > 0 ? ('- ' + formatINR(npsDeduction)) : '₹0 (OPS/GPF)';
      outNetLumpSum.innerText = formatINR(netPayable);
    }

    // Sync input when pay level dropdown changes
    arrearsPayLevel.addEventListener('change', (e) => {
      currentBasicDrawn.value = e.target.value;
      calculateArrears();
    });

    currentBasicDrawn.addEventListener('input', calculateArrears);
    arrearsFitmentSelect.addEventListener('change', calculateArrears);
    arrearsMonthsCount.addEventListener('input', calculateArrears);
    drawnDaRate.addEventListener('change', calculateArrears);
    pensionDeductCheck.addEventListener('change', calculateArrears);

    // Initial run
    calculateArrears();
  </script>
