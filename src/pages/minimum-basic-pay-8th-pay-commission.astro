  <!-- ==================== CLIENT SCRIPT: MINIMUM PAY SIMULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Minimum Pay Simulation Engine
    const baseStartingInput = document.getElementById('baseStartingInput');
    const fitmentOptionSelect = document.getElementById('fitmentOptionSelect');
    const cityTierSelect = document.getElementById('cityTierSelect');

    const dispMinBasic = document.getElementById('dispMinBasic');
    const dispMinHra = document.getElementById('dispMinHra');
    const dispMinTa = document.getElementById('dispMinTa');
    const dispMinPension = document.getElementById('dispMinPension');
    const dispMinGross = document.getElementById('dispMinGross');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateMinPay() {
      const basePay = parseFloat(baseStartingInput.value) || 18000;
      const fitment = parseFloat(fitmentOptionSelect.value) || 2.28;
      const hraRate = parseFloat(cityTierSelect.value) || 0.27;

      // 1. Revised Level 1 Minimum Basic Pay
      const newBasic = basePay * fitment;

      // 2. House Rent Allowance (HRA) with floor guarantee
      let calculatedHra = newBasic * hraRate;
      let floorLimit = 3690;
      if (hraRate >= 0.27) {
        floorLimit = 11080;
      } else if (hraRate >= 0.18) {
        floorLimit = 7390;
      }
      calculatedHra = Math.max(calculatedHra, floorLimit);

      // 3. Band 3 Transport Allowance (TA Level 1 / 2)
      const baseTa = (hraRate >= 0.27) ? 1350 : 900;
      const calculatedTa = baseTa * 1.80; // Projected 8th CPC base expansion

      // 4. Corresponding Minimum Pension (Exactly 50% of Basic)
      const minPension = newBasic * 0.50;

      // 5. Estimated Gross Starting Salary
      const grossSalary = newBasic + calculatedHra + calculatedTa;

      // Update UI elements
      dispMinBasic.innerText = formatINR(newBasic);
      dispMinHra.innerText = formatINR(calculatedHra);
      dispMinTa.innerText = formatINR(calculatedTa);
      dispMinPension.innerText = formatINR(minPension) + ' / mo';
      dispMinGross.innerText = formatINR(grossSalary);
    }

    fitmentOptionSelect.addEventListener('change', calculateMinPay);
    cityTierSelect.addEventListener('change', calculateMinPay);

    // Initial run
    calculateMinPay();
  </script>
