  <!-- ==================== CLIENT SCRIPT: UPS CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time UPS Calculator Engine
    const upsPayLevelSelect = document.getElementById('upsPayLevelSelect');
    const last12MonthsBasic = document.getElementById('last12MonthsBasic');
    const upsFitmentSelect = document.getElementById('upsFitmentSelect');
    const qualifyingYearsUps = document.getElementById('qualifyingYearsUps');
    const postDaInflationRate = document.getElementById('postDaInflationRate');

    const valRevisedAvgBasic = document.getElementById('valRevisedAvgBasic');
    const valServiceMultiplier = document.getElementById('valServiceMultiplier');
    const valAssuredBasicPension = document.getElementById('valAssuredBasicPension');
    const valDrAllowance = document.getElementById('valDrAllowance');
    const valFamilyPension = document.getElementById('valFamilyPension');
    const valLumpSumExit = document.getElementById('valLumpSumExit');
    const valNetMonthlyUps = document.getElementById('valNetMonthlyUps');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateUpsBenefits() {
      const basic = parseFloat(last12MonthsBasic.value) || 0;
      const fitment = parseFloat(upsFitmentSelect.value) || 2.28;
      const years = Math.max(10, parseFloat(qualifyingYearsUps.value) || 25);
      const drRate = parseFloat(postDaInflationRate.value) || 0.00;

      // 1. Revised Average Basic Pay under 8th CPC
      const revisedAvgBasic = basic * fitment;

      // 2. Service Proportion Factor: Full 50% at 25 years, proportionate below 25
      const serviceProportion = Math.min(1.0, years / 25.0);

      // 3. Assured Basic Pension: 50% of Basic * Proportion, subject to minimum ₹10,000 floor
      let calculatedPension = (revisedAvgBasic * 0.50) * serviceProportion;
      calculatedPension = Math.max(10000, calculatedPension);

      // 4. Dearness Relief (DR)
      const drAmount = calculatedPension * drRate;

      // 5. Net Monthly Assured Pension
      const netMonthlyPension = calculatedPension + drAmount;

      // 6. Assured Family Pension (60% of Assured Basic Pension + DR)
      const familyPension = (calculatedPension * 0.60) + (calculatedPension * 0.60 * drRate);

      // 7. Lump-sum Exit Grant: 1/10th of (Pay + DA) for every completed 6-month period (SMP = years * 2)
      const smp = Math.round(years * 2);
      const lumpSumExit = (0.10 * revisedAvgBasic) * smp;

      // Update DOM
      valRevisedAvgBasic.innerText = formatINR(revisedAvgBasic);
      valServiceMultiplier.innerText = `${(serviceProportion * 100).toFixed(0)}% (${years >= 25 ? 'Full 25+ Yrs' : `${years} Yrs Proportionate`})`;
      valAssuredBasicPension.innerText = formatINR(calculatedPension);
      valDrAllowance.innerText = drRate > 0 ? (formatINR(drAmount) + ` (${(drRate * 100).toFixed(0)}% DR)`) : '₹0 (0% Merged)';
      valFamilyPension.innerText = formatINR(familyPension);
      valLumpSumExit.innerText = formatINR(lumpSumExit);
      valNetMonthlyUps.innerText = formatINR(netMonthlyPension);
    }

    // Sync input when pay level dropdown changes
    upsPayLevelSelect.addEventListener('change', (e) => {
      last12MonthsBasic.value = e.target.value;
      calculateUpsBenefits();
    });

    last12MonthsBasic.addEventListener('input', calculateUpsBenefits);
    upsFitmentSelect.addEventListener('change', calculateUpsBenefits);
    qualifyingYearsUps.addEventListener('input', calculateUpsBenefits);
    postDaInflationRate.addEventListener('change', calculateUpsBenefits);

    // Initial calculation run
    calculateUpsBenefits();
  </script>
