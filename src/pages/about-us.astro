---
// src/pages/about-us.astro
const title = "About Us - 8PayCommission.com | Editorial Standards & Mission (2026)";
const description = "Learn about 8PayCommission.com: Our mission, editorial methodology, public compensation modeling tools, independent governance, and research standards.";
const canonicalURL = "https://8paycommission.com/about-us";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "8PayCommission",
          "url": "https://8paycommission.com",
          "logo": "https://8paycommission.com/favicon.svg",
          "email": "dailylifetech.official@gmail.com",
          "description": "Independent analytical and financial education portal dedicated to civil service compensation, pay matrices, pension modeling, and Pay Commission developments across India."
        },
        {
          "@type": "AboutPage",
          "name": "About Us - 8PayCommission",
          "url": "https://8paycommission.com/about-us",
          "description": "An overview of the editorial principles, computational methodologies, and mission behind 8PayCommission.com."
        }
      ]
    }
  </script>
</head>
