  <!-- ==================== CLIENT SCRIPT: DA HRA CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time DA HRA Calculation Engine
    const payLevelSelect = document.getElementById('payLevelSelect');
    const basicPayInput = document.getElementById('basicPayInput');
    const fitmentSelect = document.getElementById('fitmentSelect');
    const cityCategorySelect = document.getElementById('cityCategorySelect');
    const postDaRateSelect = document.getElementById('postDaRateSelect');

    const outRevisedBasic = document.getElementById('outRevisedBasic');
    const outHraTierLabel = document.getElementById('outHraTierLabel');
    const outHraAmount = document.getElementById('outHraAmount');
    const outDaAmount = document.getElementById('outDaAmount');
    const outFloorLimit = document.getElementById('outFloorLimit');
    const outTotalAllowances = document.getElementById('outTotalAllowances');
    const outCombinedTotal = document.getElementById('outCombinedTotal');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateAllowances() {
      const basic = parseFloat(basicPayInput.value) || 0;
      const fitment = parseFloat(fitmentSelect.value) || 2.28;
      const hraRate = parseFloat(cityCategorySelect.value) || 0.27;
      const daRate = parseFloat(postDaRateSelect.value) || 0.00;

      // 1. Revised Basic Pay (rounded to nearest 100)
      const revisedBasic = Math.round((basic * fitment) / 100) * 100;

      // 2. Mathematical HRA
      const rawHra = revisedBasic * hraRate;

      // 3. Minimum Floor Limits (Projected 8th CPC Floors: approx 2.05x of 7th CPC)
      let floorLimit = 3690;
      let tierLabel = 'Class Z (9%)';
      if (hraRate >= 0.27) {
        floorLimit = 11080;
        tierLabel = 'Class X (27%)';
      } else if (hraRate >= 0.18) {
        floorLimit = 7390;
        tierLabel = 'Class Y (18%)';
      }

      // 4. Payable HRA: Greater of mathematical calculation or floor guarantee
      const payableHra = Math.max(rawHra, floorLimit);

      // 5. Dearness Allowance (DA)
      const daAmount = revisedBasic * daRate;

      // 6. Total Allowances (DA + HRA)
      const totalAllowances = payableHra + daAmount;

      // 7. Combined Total (Basic + DA + HRA)
      const combinedTotal = revisedBasic + totalAllowances;

      // Update DOM
      outRevisedBasic.innerText = formatINR(revisedBasic);
      outHraTierLabel.innerText = tierLabel;
      outHraAmount.innerText = formatINR(payableHra);
      outDaAmount.innerText = daRate > 0 ? (formatINR(daAmount) + ` (${(daRate * 100).toFixed(0)}%)`) : '₹0 (0% Merged)';
      outFloorLimit.innerText = formatINR(floorLimit) + ' / month';
      outTotalAllowances.innerText = formatINR(totalAllowances);
      outCombinedTotal.innerText = formatINR(combinedTotal);
    }

    // Sync basic pay when pay level selection changes
    payLevelSelect.addEventListener('change', (e) => {
      basicPayInput.value = e.target.value;
      calculateAllowances();
    });

    basicPayInput.addEventListener('input', calculateAllowances);
    fitmentSelect.addEventListener('change', calculateAllowances);
    cityCategorySelect.addEventListener('change', calculateAllowances);
    postDaRateSelect.addEventListener('change', calculateAllowances);

    // Initial run
    calculateAllowances();
  </script>
</body>
