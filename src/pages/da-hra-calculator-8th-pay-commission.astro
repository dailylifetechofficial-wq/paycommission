  <!-- ==================== CLIENT SCRIPT: DA HRA CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time DA HRA Calculator Engine
    const allowancePayLevel = document.getElementById('allowancePayLevel');
    const allowanceBasicPay = document.getElementById('allowanceBasicPay');
    const fitmentScenario = document.getElementById('fitmentScenario');
    const cityCategorySelect = document.getElementById('cityCategorySelect');
    const postDaCycleSelect = document.getElementById('postDaCycleSelect');

    const valRevisedBasic = document.getElementById('valRevisedBasic');
    const valCalculatedHra = document.getElementById('valCalculatedHra');
    const valCalculatedDa = document.getElementById('valCalculatedDa');
    const valCalculatedTa = document.getElementById('valCalculatedTa');
    const valTotalAllowances = document.getElementById('valTotalAllowances');
    const valTotalGrossMonthly = document.getElementById('valTotalGrossMonthly');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function computeAllowances() {
      const basic = parseFloat(allowanceBasicPay.value) || 0;
      const fitment = parseFloat(fitmentScenario.value) || 2.28;
      const hraRate = parseFloat(cityCategorySelect.value) || 0.27;
      const daRate = parseFloat(postDaCycleSelect.value) || 0.00;

      // 1. Revised Basic Pay
      const newBasic = basic * fitment;

      // 2. House Rent Allowance (HRA)
      const calculatedHra = newBasic * hraRate;

      // 3. Post-Reset Dearness Allowance (DA)
      const calculatedDa = newBasic * daRate;

      // 4. Transport Allowance (Tier-scaled estimation)
      const baseTa = basic >= 35400 ? 3600 : 1350;
      const calculatedTa = (baseTa * 1.6) + ((baseTa * 1.6) * daRate);

      // 5. Total Monthly Allowances (HRA + DA + TA)
      const totalAllowances = calculatedHra + calculatedDa + calculatedTa;

      // 6. Total Gross Monthly (New Basic + Total Allowances)
      const totalGross = newBasic + totalAllowances;

      // Update UI elements
      valRevisedBasic.innerText = formatINR(newBasic);
      valCalculatedHra.innerText = formatINR(calculatedHra);
      valCalculatedDa.innerText = daRate > 0 ? (formatINR(calculatedDa) + ` (${(daRate * 100).toFixed(0)}%)`) : '₹0 (0% Merged)';
      valCalculatedTa.innerText = formatINR(calculatedTa);
      valTotalAllowances.innerText = formatINR(totalAllowances);
      valTotalGrossMonthly.innerText = formatINR(totalGross);
    }

    // Sync basic pay when level selection changes
    allowancePayLevel.addEventListener('change', (e) => {
      allowanceBasicPay.value = e.target.value;
      computeAllowances();
    });

    allowanceBasicPay.addEventListener('input', computeAllowances);
    fitmentScenario.addEventListener('change', computeAllowances);
    cityCategorySelect.addEventListener('change', computeAllowances);
    postDaCycleSelect.addEventListener('change', computeAllowances);

    // Initial calculation run
    computeAllowances();
  </script>
</body>
