  <!-- ==================== CLIENT SCRIPT: UP SALARY CALCULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Uttar Pradesh Salary Calculation Engine
    const upLevelSelect = document.getElementById('upLevelSelect');
    const upCurrentBasic = document.getElementById('upCurrentBasic');
    const upFitmentSelect = document.getElementById('upFitmentSelect');
    const upCityCategorySelect = document.getElementById('upCityCategorySelect');
    const upPensionSelect = document.getElementById('upPensionSelect');

    const outUpRevisedBasic = document.getElementById('outUpRevisedBasic');
    const outUpHra = document.getElementById('outUpHra');
    const outUpTa = document.getElementById('outUpTa');
    const outUpGross = document.getElementById('outUpGross');
    const outUpPensionDeduct = document.getElementById('outUpPensionDeduct');
    const outUpFixedDeduct = document.getElementById('outUpFixedDeduct');
    const outUpNetTakeHome = document.getElementById('outUpNetTakeHome');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateUpSalary() {
      const basic = parseFloat(upCurrentBasic.value) || 0;
      const fitment = parseFloat(upFitmentSelect.value) || 2.28;
      const hraRate = parseFloat(upCityCategorySelect.value) || 0.27;
      const pensionRate = parseFloat(upPensionSelect.value) || 0.10;

      // 1. Revised Basic Pay (rounded to nearest 100)
      const revisedBasic = Math.round((basic * fitment) / 100) * 100;

      // 2. House Rent Allowance (HRA) with UP floor protection
      let calculatedHra = revisedBasic * hraRate;
      let floorLimit = 3690;
      if (hraRate >= 0.27) floorLimit = 11080;
      else if (hraRate >= 0.18) floorLimit = 7390;
      calculatedHra = Math.max(calculatedHra, floorLimit);

      // 3. Transport Allowance (TA estimation)
      const selectedOption = upLevelSelect.options[upLevelSelect.selectedIndex];
      const lvl = parseInt(selectedOption.getAttribute('data-level')) || 3;
      let baseTa = (lvl >= 9) ? 7200 : (lvl >= 3 ? 3600 : 1350);
      if (hraRate < 0.18) {
        baseTa = (lvl >= 9) ? 3600 : (lvl >= 3 ? 1800 : 900);
      }
      const calculatedTa = baseTa * 1.60;

      // 4. Estimated Gross Salary
      const grossSalary = revisedBasic + calculatedHra + calculatedTa;

      // 5. Deductions
      const pensionDeduction = revisedBasic * pensionRate;
      const fixedDeductions = 500; // GIS (Group Insurance Scheme) + State Health Fund
      const totalDeductions = pensionDeduction + fixedDeductions;

      // 6. Net Take-Home Pay
      const netSalary = grossSalary - totalDeductions;

      // Update DOM
      outUpRevisedBasic.innerText = formatINR(revisedBasic);
      outUpHra.innerText = formatINR(calculatedHra);
      outUpTa.innerText = formatINR(calculatedTa);
      outUpGross.innerText = formatINR(grossSalary);
      outUpPensionDeduct.innerText = pensionDeduction > 0 ? ('- ' + formatINR(pensionDeduction)) : '₹0 (GPF)';
      outUpFixedDeduct.innerText = '- ' + formatINR(fixedDeductions);
      outUpNetTakeHome.innerText = formatINR(netSalary);
    }

    // Sync input when UP Level dropdown changes
    upLevelSelect.addEventListener('change', (e) => {
      upCurrentBasic.value = e.target.value;
      calculateUpSalary();
    });

    upCurrentBasic.addEventListener('input', calculateUpSalary);
    upFitmentSelect.addEventListener('change', calculateUpSalary);
    upCityCategorySelect.addEventListener('change', calculateUpSalary);
    upPensionSelect.addEventListener('change', calculateUpSalary);

    // Initial run
    calculateUpSalary();
  </script>
