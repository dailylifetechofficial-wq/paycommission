  <!-- ==================== CLIENT SCRIPT: FITMENT SIMULATOR ==================== -->
  <script is:inline>
    // Navigation drawer for mobile
    const toggleBtn = document.getElementById('mobileNavToggle');
    const navMenu = document.getElementById('mainNavigation');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        navMenu.classList.toggle('open');
        toggleBtn.classList.toggle('active');
      });
    }

    // Touch dropdown handlers
    const dropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    dropdownTriggers.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (window.innerWidth <= 960) {
          e.preventDefault();
          const parent = btn.parentElement;
          parent.classList.toggle('active');
        }
      });
    });

    // Real-Time Fitment Calculation Engine
    const cadreLevelSelect = document.getElementById('cadreLevelSelect');
    const basicPayInput = document.getElementById('basicPayInput');
    const fitmentFactorSelect = document.getElementById('fitmentFactorSelect');

    const dispRevisedBasic = document.getElementById('dispRevisedBasic');
    const dispGrossIncrement = document.getElementById('dispGrossIncrement');
    const dispDaPortion = document.getElementById('dispDaPortion');
    const dispRealWageGrowth = document.getElementById('dispRealWageGrowth');
    const dispEffectiveHikePercent = document.getElementById('dispEffectiveHikePercent');

    function formatINR(val) {
      return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    function calculateFitment() {
      const basic = parseFloat(basicPayInput.value) || 0;
      const fitment = parseFloat(fitmentFactorSelect.value) || 2.28;
      const daRate = 0.53; // Current accumulated DA baseline

      // 1. Revised Basic Pay
      const newBasic = basic * fitment;

      // 2. Gross Increment over existing basic
      const grossIncrement = newBasic - basic;

      // 3. DA Already Drawn Portion (to be absorbed)
      const daPortion = basic * daRate;

      // 4. Real Net Wage Growth (over basic + DA)
      const realGrowth = newBasic - (basic + daPortion);

      // 5. Effective Percentage Hike over total emoluments (Basic + DA)
      const oldEmoluments = basic + daPortion;
      const effectiveHike = oldEmoluments > 0 ? ((realGrowth / oldEmoluments) * 100) : 0;

      // Update DOM
      dispRevisedBasic.innerText = formatINR(newBasic);
      dispGrossIncrement.innerText = '+ ' + formatINR(grossIncrement);
      dispDaPortion.innerText = formatINR(daPortion) + ' (Merged)';
      dispRealWageGrowth.innerText = '+ ' + formatINR(realGrowth);
      dispEffectiveHikePercent.innerText = effectiveHike.toFixed(1) + '%';
    }

    // Sync input when pay level dropdown changes
    cadreLevelSelect.addEventListener('change', (e) => {
      basicPayInput.value = e.target.value;
      calculateFitment();
    });

    basicPayInput.addEventListener('input', calculateFitment);
    fitmentFactorSelect.addEventListener('change', calculateFitment);

    // Initial run
    calculateFitment();
  </script>
