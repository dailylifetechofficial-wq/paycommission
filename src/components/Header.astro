---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav class="site-nav" aria-label="Main navigation">
		<a href="/" class="brand" aria-label="8PayCommission home">
			<span class="brand-mark">₹</span>
			<span class="brand-text">{SITE_TITLE}</span>
		</a>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about-us/">About</HeaderLink>
			<HeaderLink href="/contact-us/">Contact</HeaderLink>
			<HeaderLink href="/privacy-policy/">Privacy</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(15, 43, 72, 0.08);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.9rem 1.25rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 800;
		text-decoration: none;
		color: #0f2b48;
		letter-spacing: -0.03em;
	}

	.brand-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.65rem;
		background: linear-gradient(135deg, #0f2b48, #2563eb);
		color: white;
		font-size: 1.15rem;
	}

	.brand-text {
		font-size: 1.05rem;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
	}

	@media (max-width: 720px) {
		.site-nav {
			padding: 0.8rem 0.9rem;
		}

		.brand-text {
			font-size: 0.95rem;
		}

		.internal-links {
			gap: 0.2rem;
		}
	}
</style>
