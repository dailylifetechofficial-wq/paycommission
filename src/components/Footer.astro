---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<p>&copy; {today.getFullYear()} 8PayCommission. All rights reserved.</p>
		<div class="footer-links">
			<a href="/about-us/">About</a>
			<a href="/contact-us/">Contact</a>
			<a href="/privacy-policy/">Privacy Policy</a>
			<a href="/terms-of-condition/">Terms</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: #f8fafc;
		border-top: 1px solid rgba(15, 43, 72, 0.08);
		margin-top: 3rem;
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.25rem;
		text-align: center;
	}

	.footer-inner p {
		margin: 0 0 0.8rem;
		color: #475569;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-links a {
		color: #0f2b48;
		text-decoration: none;
		font-weight: 600;
	}

	.footer-links a:hover {
		text-decoration: underline;
	}
</style>
